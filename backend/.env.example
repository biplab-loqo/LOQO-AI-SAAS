# ── MongoDB ──────────────────────────────────────────────
MONGODB_URL=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=loqo_db

# ── Auth / JWT ───────────────────────────────────────────
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Google OAuth ─────────────────────────────────────────
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# ── CORS ─────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:8001

# ── AWS S3 ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET=your-s3-bucket
S3_BUCKET_NAME=your-s3-bucket
PRIVATE_S3_BUCKETS=

# ── AWS SQS ──────────────────────────────────────────────
AWS_SQS_QUEUE_URL=

# ── Static base URL for seed images ─────────────────────
STATIC_BASE_URL=/media/demodata

# ── CloudFront CDN ───────────────────────────────────────
CLOUDFRONT_DOMAIN=
CLOUDFRONT_KEY_PAIR_ID=
CLOUDFRONT_PRIVATE_KEY_PATH=

# ── AWS MediaConvert (video transcoding) ─────────────────
MEDIACONVERT_ENDPOINT=
MEDIACONVERT_ROLE_ARN=

# ── Media processing ─────────────────────────────────────
IMAGE_WIDTHS=650
VIDEO_MAX_HEIGHT=1080

# ── Project identity ─────────────────────────────────────
PROJECT_NAME=Loqo AI Studio
API_PREFIX=/api/v1
